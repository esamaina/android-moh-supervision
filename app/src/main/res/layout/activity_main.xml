<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light"
    android:padding="16dp">

    <TextView
        android:id="@+id/syncTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SST Sync Center"
        android:textColor="@color/kenya_black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/backMenuBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/backMenuBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/kenya_green"
        android:text="Menu"
        android:textColor="@color/kenya_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/baseUrlInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/kenya_white"
        android:hint="Base URL (e.g. https://chw-supervision.echis.go.ke/)"
        android:inputType="textUri"
        android:textColor="@color/kenya_black"
        android:textColorHint="@color/kenya_green"
        android:text="https://chw-supervision.echis.go.ke/"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/syncTitle" />

    <EditText
        android:id="@+id/usernameInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/kenya_white"
        android:hint="Username"
        android:textColor="@color/kenya_black"
        android:textColorHint="@color/kenya_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/baseUrlInput" />

    <EditText
        android:id="@+id/passwordInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/kenya_white"
        android:hint="Password"
        android:inputType="textPassword"
        android:textColor="@color/kenya_black"
        android:textColorHint="@color/kenya_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/usernameInput" />

    <EditText
        android:id="@+id/deviceIdInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/kenya_white"
        android:hint="Device ID"
        android:textColor="@color/kenya_black"
        android:textColorHint="@color/kenya_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/passwordInput" />

    <Button
        android:id="@+id/pushSyncBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/kenya_red"
        android:text="Push Sync"
        android:textColor="@color/kenya_white"
        app:layout_constraintEnd_toStartOf="@id/pullSyncBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/deviceIdInput"
        app:layout_constraintWidth_percent="0.48" />

    <Button
        android:id="@+id/pullSyncBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/kenya_green"
        android:text="Pull Sync"
        android:textColor="@color/kenya_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/pushSyncBtn"
        app:layout_constraintTop_toBottomOf="@id/deviceIdInput"
        app:layout_constraintWidth_percent="0.48" />

    <Button
        android:id="@+id/stateBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/kenya_white"
        android:text="Check Sync State"
        android:textColor="@color/kenya_black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pushSyncBtn" />

    <Button
        android:id="@+id/retryFailedBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/kenya_red"
        android:text="Retry Failed Queue"
        android:textColor="@color/kenya_white"
        app:layout_constraintEnd_toStartOf="@id/clearQueueBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stateBtn"
        app:layout_constraintWidth_percent="0.48" />

    <Button
        android:id="@+id/clearQueueBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/kenya_white"
        android:text="Clear Queue"
        android:textColor="@color/kenya_black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/retryFailedBtn"
        app:layout_constraintTop_toBottomOf="@id/stateBtn"
        app:layout_constraintWidth_percent="0.48" />

    <TextView
        android:id="@+id/outputView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:background="@color/surface_light"
        android:padding="12dp"
        android:text="Ready."
        android:textColor="@color/kenya_black"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/retryFailedBtn" />

</androidx.constraintlayout.widget.ConstraintLayout>
