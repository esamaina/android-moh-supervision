<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kenya_black"
    android:padding="16dp">

    <TextView
        android:id="@+id/titleView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Supervision Records"
        android:textColor="@color/kenya_white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Spinner
        android:id="@+id/statusFilterSpinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/kenya_white"
        android:contentDescription="Filter supervision records by completion status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleView" />

    <Button
        android:id="@+id/syncAllBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/kenya_green"
        android:contentDescription="Sync all local records to server"
        android:text="Sync All"
        android:textColor="@color/kenya_white"
        app:layout_constraintEnd_toStartOf="@id/refreshBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusFilterSpinner"
        app:layout_constraintWidth_percent="0.48" />

    <Button
        android:id="@+id/refreshBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/kenya_red"
        android:contentDescription="Refresh records list"
        android:text="Refresh"
        android:textColor="@color/kenya_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/syncAllBtn"
        app:layout_constraintTop_toBottomOf="@id/titleView"
        app:layout_constraintWidth_percent="0.48" />

    <Button
        android:id="@+id/deleteFirstBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/kenya_white"
        android:contentDescription="Delete currently selected supervision record"
        android:text="Delete Selected (long press first)"
        android:textColor="@color/kenya_black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/syncAllBtn" />

    <Button
        android:id="@+id/toggleStatusBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/kenya_red"
        android:contentDescription="Toggle selected record between complete and incomplete"
        android:text="Toggle Complete/Incomplete"
        android:textColor="@color/kenya_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/deleteFirstBtn" />

    <Button
        android:id="@+id/syncSelectedBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/kenya_green"
        android:contentDescription="Sync selected supervision record"
        android:text="Sync Selected"
        android:textColor="@color/kenya_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toggleStatusBtn" />

    <Button
        android:id="@+id/resolveConflictBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/kenya_white"
        android:contentDescription="Resolve conflict policy for selected record"
        android:text="Resolve Sync Conflict"
        android:textColor="@color/kenya_black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/syncSelectedBtn" />

    <ListView
        android:id="@+id/draftList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:background="@color/surface_light"
        android:contentDescription="Supervision records list"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/resolveConflictBtn" />

</androidx.constraintlayout.widget.ConstraintLayout>
